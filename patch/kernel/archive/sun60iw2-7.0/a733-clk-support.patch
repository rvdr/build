+
+	err = platform_driver_register(&sun60iw2_r_ccu_driver);
+	if (err)
+		pr_err("register ccu sun60iw2 r failed\n");
+
+	return err;
+}
+
+core_initcall(sun60iw2_r_ccu_init);
+
+static void __exit sun60iw2_r_ccu_exit(void)
+{
