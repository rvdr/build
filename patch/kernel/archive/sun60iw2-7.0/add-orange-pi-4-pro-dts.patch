+	/*
+	 * @hdmi_hdcp1x_enable: control hdcp1x function
+	 *	- 1: enable hdcp1x
+	 *	- 0: disable hdcp1x
+	 * @hdmi_hdcp2x_enable: control hdcp2x function
+	 *	- 1: enable hdcp2x
