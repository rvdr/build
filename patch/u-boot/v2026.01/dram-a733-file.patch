@@ -0,0 +1,204 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * sun60i A733 platform DRAM controller driver
+ * Reverse-engineered from boot0 for 2400 MHz LPDDR5.
+ */
+#include <init.h>
+#include <log.h>
+#include <asm/io.h>
+#include <asm/arch/clock.h>
+#include <asm/arch/dram.h>
+#include <asm/arch/dram_dw_helpers.h>
+#include <asm/arch/cpu.h>
+#include <asm/arch/prcm.h>
+#include <linux/bitops.h>
+#include <linux/delay.h>
+
+/* A733 Basis-Adressen für Clock und RAM */
+#define SUNXI_DRAM_COM_BASE     0x0a020000
+#define SUNXI_DRAM_MCTL_BASE    0x0a100000
+#define SUNXI_DRAM_PHY_CTRL_BASE 0x0a110000
+#define SUNXI_DRAM_PHY_DATA_BASE 0x0a130000
+
+/* * 1. System und Clock Initialisierung (Die Magie aus sub_308DC)
+ */
+static void mctl_sys_init(u32 clk_rate)
+{
+        void * const ccm = (void *)SUNXI_CCM_BASE;
+        void * const mctl_com = (void *)SUNXI_DRAM_COM_BASE;
+
+        /* Reset-Zustand für DRAM und MBUS erzwingen */
+        clrsetbits_le32(ccm + 0x588, 0x88000000, 0x08000000);
+        clrbits_le32(ccm + 0x584, BIT(16) | BIT(0));
+        clrbits_le32(ccm + 0xC0C, BIT(16) | BIT(0));
+
+        /* MBUS aufwecken */
+        setbits_le32(ccm + 0xC0C, BIT(16) | BIT(0));
+
+        /* DRAM COM Base Vor-Initialisierung */
+        clrsetbits_le32(mctl_com + 0x10, 0x2700, 0x0100);
+        clrsetbits_le32(mctl_com + 0x10, 0x2700, 0x2600);
+
+        /* PLL (Takt-Multiplikator) konfigurieren */
+        clrbits_le32(ccm + 0x020, BIT(31));
+        udelay(5);
+
+        writel(BIT(31) | BIT(30) | BIT(29) | CCM_PLL5_CTRL_N(clk_rate * 2 / 24),
+               ccm + 0x020);
+
+        mctl_await_completion(ccm + 0x020, BIT(28), BIT(28));
+        udelay(5);
+
+        /* Takt an DRAM und MBUS weiterleiten */
+        clrsetbits_le32(ccm + 0xC00, 0x8F000000, 0x88000000);
+
+        setbits_le32(ccm + 0xC0C, BIT(16) | BIT(0));
+        clrsetbits_le32(ccm + 0x588, 0x8F000000, 0x89000000);
+
+        setbits_le32(ccm + 0x584, BIT(16) | BIT(0));
+
+        clrsetbits_le32(ccm + 0x580, 0xCF000000, 0xCB000000);
+
+        udelay(5);
+}
+
+/* * 2. DFI Timings (From sub_2FC68)
+ * Connects the digital controller with the analog PHY
+ */
+static void mctl_phy_dfi_config(const struct dram_config *config)
+{
+        /* Simplified values for 2400 MHz LPDDR5 based on IDA */
+        u32 v3 = 10;
+        u32 v4 = 14; /* tCL */
+        u32 v5 = 2;
+
+        u32 v8 = v5 << 8;
+        u32 v9 = (v5 << 8) | (v5 << 16) | (v5 << 24);
+        u32 v14 = v3 - 3 + v5;
+        u32 v15 = v14 << 8;
+
+        writel(v9, SUNXI_DRAM_PHY_DATA_BASE + 0x018);
+        writel(v5 | 0x1F000000 | v8 | (v5 << 16), SUNXI_DRAM_PHY_DATA_BASE + 0x014);
+        writel(257, SUNXI_DRAM_PHY_DATA_BASE + 0x010); /* 0x0101 */
+        writel(v14 | 0x3F0000 | v15, SUNXI_DRAM_PHY_DATA_BASE + 0x00C);
+
+        u32 v17 = v5 + 3 + v3; /* Assumption v28 = 3 for LPDDR5 setup */
+        u32 v18 = v18;
+        u32 v19 = (v18) | ((v18) << 8);
+        u32 v20 = v19 | ((v18) << 16);
+        u32 v21 = v20 | ((v18) << 24);
+
+        writel(v19, SUNXI_DRAM_PHY_DATA_BASE + 0x02C);
+        writel(v21, SUNXI_DRAM_PHY_DATA_BASE + 0x028);
+        writel(v21, SUNXI_DRAM_PHY_DATA_BASE + 0x024);
+        writel(v21, SUNXI_DRAM_PHY_DATA_BASE + 0x020);
+
+	if (v4 == 14) {
+                /* LPDDR5 specific */
+                writel(522133279, SUNXI_DRAM_PHY_DATA_BASE + 0x01C); /* 0x1F1F1F1F */
+                writel(16191, SUNXI_DRAM_PHY_DATA_BASE + 0x004);     /* 0x3F3F */
+        }
+
+        /* LPDDR5 PHY overrides (End of sub_2FC68) */
+        writel(0x0a090a01, SUNXI_DRAM_PHY_CTRL_BASE + 0x220);
+        writel(0x00000000, SUNXI_DRAM_PHY_CTRL_BASE + 0x224);
+}
+
+/* * 3. Controller Timings (File built previously)
+ */
+extern void mctl_set_timing_params(u32 clk);
+
+/* * 4. PHY Initialization & Training (From sub_2FF64)
+ */
+static bool mctl_phy_init(const struct dram_para *para,
+                          const struct dram_config *config)
+{
+        /* Initialize PHY control registers */
+        clrsetbits_le32(SUNXI_DRAM_PHY_CTRL_BASE + 0x010, 0x0101, 0x0001);
+        clrbits_le32(SUNXI_DRAM_PHY_CTRL_BASE + 0x18c, 0x3f);
+        clrsetbits_le32(SUNXI_DRAM_PHY_CTRL_BASE + 0x180, 0x800, 0x800);
+        clrsetbits_le32(SUNXI_DRAM_PHY_CTRL_BASE + 0x508, 0x40008000, 0xc0000000);
+
+        /* LPDDR5 specific config */
+        if (para->type == SUNXI_DRAM_TYPE_LPDDR4) {
+                clrbits_le32(SUNXI_DRAM_PHY_CTRL_BASE + 0x280, 0x20000000);
+                setbits_le32(SUNXI_DRAM_PHY_CTRL_BASE + 0x280, 0x80000000);
+        }
+        setbits_le32(SUNXI_DRAM_PHY_CTRL_BASE + 0x288, 1);
+
+        clrsetbits_le32(SUNXI_DRAM_PHY_CTRL_BASE + 0x300, 0x00ff00ff, 0x00c000c0);
+        setbits_le32(SUNXI_DRAM_PHY_CTRL_BASE + 0x308, 1);
+
+        writel(0, SUNXI_DRAM_PHY_CTRL_BASE + 0x500);
+        clrsetbits_le32(SUNXI_DRAM_PHY_CTRL_BASE + 0x518, 0x00000001, 0x25000000);
+        setbits_le32(SUNXI_DRAM_PHY_CTRL_BASE + 0x208, 1);
+        clrsetbits_le32(SUNXI_DRAM_PHY_CTRL_BASE + 0x510, 0x00030015, 0x00010015);
+
+        /* Rank/Bus setup (From sub_2FF00) */
+        if (config->bus_full_width)
+                writel(0x0303, SUNXI_DRAM_PHY_CTRL_BASE + 0xC9C);
+        else
+                writel(0x0001, SUNXI_DRAM_PHY_CTRL_BASE + 0xC9C);
+
+        /* Load DFI and timings */
+        mctl_phy_dfi_config(config);
+        mctl_set_timing_params(config->clk);
+
+        /* START PHY TRAINING */
+        clrbits_le32(SUNXI_DRAM_PHY_CTRL_BASE + 0xb84, 1);
+        writel(0, SUNXI_DRAM_PHY_CTRL_BASE + 0xc80); /* Clear PIR */
+
+        clrsetbits_le32(SUNXI_DRAM_PHY_CTRL_BASE + 0x510, 0x00030015, 0x00010004);
+
+        /* Set PIR trigger */
+        writel(1, SUNXI_DRAM_PHY_CTRL_BASE + 0xc80);
+
+        /* Wait for IDONE */
+        mctl_await_completion((u32 *)(SUNXI_DRAM_PHY_CTRL_BASE + 0xc84), 1, 1);
+
+        writel(0, SUNXI_DRAM_PHY_CTRL_BASE + 0xc80);
+        clrsetbits_le32(SUNXI_DRAM_PHY_CTRL_BASE + 0x510, 0x00030015, 0x00010014);
+
+        writel(1, SUNXI_DRAM_PHY_CTRL_BASE + 0xc80);
+        mctl_await_completion((u32 *)(SUNXI_DRAM_PHY_CTRL_BASE + 0xc84), 1, 1);
+
+        return true;
+}
+
+/* * 5. Main Controller Init
+ */
+static bool mctl_ctrl_init(const struct dram_para *para,
+                           const struct dram_config *config)
+{
+        if (!mctl_phy_init(para, config)) {
+                debug("DRAM PHY training failed!\n");
+                return false;
+        }
+
+        /* Optional: ZQ calibration and MBUS config can be added here later */
+        return true;
+}
+
+/* * 6. Entry point for the U-Boot bootloader
+ */
+unsigned long sunxi_dram_init(void)
+{
+        /* Configuration for your specific board (A733 / LPDDR5) */
+        struct dram_para para = {
+                .type = SUNXI_DRAM_TYPE_LPDDR4, /* U-Boot often uses the same enum value for newer LPDDRs */
+        };
+        struct dram_config config = {
+                .clk = CONFIG_DRAM_CLK, /* Defined in defconfig/Kconfig */
+                .ranks = 1,
+                .bus_full_width = 1,
+        };
+
+        /* Starte die Clocks und die Stromversorgung für den RAM! */
+        mctl_sys_init(config.clk);
+
+        if (!mctl_ctrl_init(&para, &config))
+                return 0;
+
+        /* Return a fixed RAM size (e.g. 4 GB) until auto-detect is implemented */
+        return (4UL * 1024 * 1024 * 1024);
+}
diff --git a/arch/arm/mach-sunxi/dram_timings/a733_lpddr5.c b/arch/arm/mach-sunxi/dram_timings/a733_lpddr5.c
new file mode 100644
index 00000000000..ddddbdbda2d
--- /dev/null
+++ b/arch/arm/mach-sunxi/dram_timings/a733_lpddr5.c
@@ -0,0 +1,82 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * sun60i A733 LPDDR5 timings, as programmed by Allwinner's boot0.
+ * Reverse-engineered from raw boot0 binary for 2400 MHz LPDDR5.
+ */
+
+#include <asm/arch/cpu.h>
+#include <asm/arch/dram.h>
+
+#define SUNXI_DRAM_CTL0_BASE    0x0a100000 // DRAM Controller Base Address NCAT2
+
+void mctl_set_timing_params(u32 clk)
+{
+        struct sunxi_mctl_ctl_reg * const mctl_ctl =
+                        (struct sunxi_mctl_ctl_reg *)SUNXI_DRAM_CTL0_BASE;
+
+        /*
+         * LPDDR5 Base Timings
+         * Formulas extracted and simplified from boot0 sub_24488
+         */
+        u8 tcl      = 14;                           /* CAS Latency */
+        u8 tcwl     = 22;                           /* CAS Write Latency */
+        u8 trcd     = max(ns_to_t(18, clk), 2);     /* 18 ns */
+        u8 trp      = max(ns_to_t(21, clk), 2);     /* 21 ns */
+        u8 tras     = max(ns_to_t(42, clk), 3);     /* 42 ns */
+        u8 trc      = tras + trp;
+        u8 tfaw     = ns_to_t(20, clk);             /* 20 ns */
+        u8 trrd     = max(ns_to_t(5, clk), 2);      /* 5 ns */
+        u8 tccd     = 4;
+
+        u8 txp      = max(ns_to_t(7, clk), 3);      /* 7 ns */
+        u8 trtp     = max(ns_to_t(8, clk), 2);      /* 8 ns */
+
+        u16 trefi   = ns_to_t(3906, clk) / 32;      /* 3.9 us */
+        u8 trasmax  = (trefi * 9) / 32;
+        u8 twtp     = tcwl + 10;
+
+        u8 tcke     = ns_to_t(10, clk) + 1;         /* 10 ns */
+        u8 tckesr   = max(ns_to_t(15, clk), 2);     /* 15 ns */
+        u8 tcksre   = max(ns_to_t(5, clk), 3);      /* 5 ns */
+        u8 tcksrx   = 2;
+
+        u8 twr2rd   = tcl + 3;
+        u8 trd2wr   = 25;                           /* txp_calc + 11 */
+
+        u32 txsr      = ns_to_t(380, clk) + trtp;
+        u32 txsr_max  = max(ns_to_t(40, clk), 8);
+        u32 txsr_calc = (ns_to_t(380, clk) & 0x3FF) ? 1 : 0;
+
+        /* set DRAM timing */
+        writel((twtp << 24) | (tfaw << 16) | (trasmax << 8) | tras,
+               &mctl_ctl->dramtmg[0]);
+        writel((txp << 16) | (trtp << 8) | trc,
+               &mctl_ctl->dramtmg[1]);
+        writel((7 << 24) | (tcl << 16) | (twr2rd << 8) | trd2wr,
+               &mctl_ctl->dramtmg[2]);
+        writel((0x3A << 8) | (10 << 16) | 0x24,
+               &mctl_ctl->dramtmg[3]);
+        writel((trcd << 24) | (tccd << 16) | (trrd << 8) | trp,
+               &mctl_ctl->dramtmg[4]);
+        writel((tcksrx << 24) | (tcksre << 16) | (tckesr << 8) | tcke,
+               &mctl_ctl->dramtmg[5]);
+        writel(txp + 2,
+               &mctl_ctl->dramtmg[6]);
+        writel(ns_to_t(3, clk),
+               &mctl_ctl->dramtmg[7]);
+        writel(13 | 0x20000 | ((trrd + 1) << 8),
+               &mctl_ctl->dramtmg[9]);
+        writel(3 << 16,
+               &mctl_ctl->dramtmg[12]);
+        writel(2 | (16 << 16) | (10 << 24),
+               &mctl_ctl->dramtmg[13]);
+        writel(txsr | (txsr_max << 16),
+               &mctl_ctl->dramtmg[14]);
+        writel(tcke | (txsr_calc << 16),
+               &mctl_ctl->dramtmg[23]);
+
+        /*
+         * Note: DFI timings (dfitmg) and PHY configurations (SUNXI_DRAM_PHY0_BASE)
+         * are extracted separately and should be implemented in the PHY init sequence.
+         */
+}
