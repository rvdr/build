diff --git a/arch/arm/include/asm/arch-sunxi/dram_sun60i_a733.h b/arch/arm/include/asm/arch-sunxi/dram_sun60i_a733.h
new file mode 100644
index 000000000000..111111111111
--- /dev/null
+++ b/arch/arm/include/asm/arch-sunxi/dram_sun60i_a733.h
@@ -0,0 +1,105 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * sun60iw2 (A733/T527) DRAM controller register and constant defines
+ * Reversed via IDA Pro from Allwinner boot0
+ * * Supports LPDDR5 memory.
+ */
+
+#ifndef _SUNXI_DRAM_SUN60IW2_H
+#define _SUNXI_DRAM_SUN60IW2_H
+
+#include <linux/bitops.h>
+
+/* LPDDR5 DRAM Type Constant from boot0 FEX */
+enum sunxi_dram_type {
+	SUNXI_DRAM_TYPE_DDR3 = 3,
+	SUNXI_DRAM_TYPE_DDR4 = 4,
+	SUNXI_DRAM_TYPE_LPDDR3 = 7,
+	SUNXI_DRAM_TYPE_LPDDR4 = 8,
+	SUNXI_DRAM_TYPE_LPDDR5 = 9,
+};
+
+/*
+ * Memory Map
+ */
+#define SUNXI_CPU_AXI2HIF0_BASE 0x0A030000
+#define SUNXI_CPU_AXI2HIF1_BASE 0x0A040000
+#define SUNXI_NSI_BASE		  0x02020000
+
+/* * Base Addresses for sun60iw2
+ * Synopsys DW uMCTL2 architecture splits COM, CTL, PHY, and Mailbox SRAM
+ */
+#define SUNXI_DRAM_COM_BASE	 0x0A020000
+#define SUNXI_DRAM_CTL0_BASE	0x0A100000 //DRAM Controller0
+#define SUNXI_DRAM_PHY0_BASE	0x0A110000
+#define SUNXI_DRAM_CTL1_BASE	0x0A500000 //DRAM Controller1
+#define SUNXI_DRAM_PHY1_BASE	0x0A510000
+
+#define SUNXI_NSI_BASE		  0x02020000
+
+/*
+ * Exact reconstruction of the FEX dram_para structure.
+ * Mapped from boot0 parameter offsets (e.g. a1 + 120 == tpr13)
+ */
+struct dram_para {
+	u32 dram_clk;	   /* 0x00 */
+	u32 type;		   /* 0x04 */
+	u32 dx_odt;		 /* 0x08 */
+	u32 dx_dri;		 /* 0x0c */
+	u32 ca_dri;		 /* 0x10 */
+	u32 para0;		  /* 0x14 */
+	u32 para1;		  /* 0x18 */
+	u32 para2;		  /* 0x1c */
+	u32 mr0;			/* 0x20 */
+	u32 mr1;			/* 0x24 */
+	u32 mr2;			/* 0x28 */
+	u32 mr3;			/* 0x2c */
+	u32 mr4;			/* 0x30 */
+	u32 mr5;			/* 0x34 */
+	u32 mr6;			/* 0x38 */
+	u32 mr11;		   /* 0x3c */
+	u32 mr12;		   /* 0x40 */
+	u32 mr13;		   /* 0x44 */
+	u32 mr14;		   /* 0x48 */
+	u32 mr16;		   /* 0x4c */
+	u32 mr17;		   /* 0x50 */
+	u32 mr22;		   /* 0x54 */
+	u32 tpr0;		   /* 0x58 */
+	u32 tpr1;		   /* 0x5c */
+	u32 tpr2;		   /* 0x60 */
+	u32 tpr3;		   /* 0x64 */
+	u32 tpr6;		   /* 0x68 */
+	u32 tpr10;		  /* 0x6c */
+	u32 tpr11;		  /* 0x70 */
+	u32 tpr12;		  /* 0x74 */
+	u32 tpr13;		  /* 0x78 (120 dezimal - Dual Channel Bit 0x40) */
+	u32 tpr14;		  /* 0x7c */
+};
+
+/* * Configuration struct used internally by the driver
+ */
+struct dram_config {
+	u8 cols;
+	u8 rows;
+	u8 ranks;
+	u8 bus_full_width;
+	u32 clk;
+	u32 odt_en;
+	u32 tpr11;
+	u32 tpr12;
+	u32 tpr14;
+};
+
+/* * Helper function to convert JEDEC nanosecond timings into clock cycles.
+ * In LPDDR5 mode, boot0 calculates timings based on clk / 4 (dfi_clk).
+ */
+static inline int ns_to_t(int nanoseconds, u32 dfi_clk)
+{
+	/* dfi_clk is typically passed as config->clk / 4 */
+	return DIV_ROUND_UP(dfi_clk * nanoseconds, 1000);
+}
+
+void mctl_set_timing_params(const struct dram_config *config);
+bool mctl_core_init(const struct dram_para *para, const struct dram_config *config);
+
+#endif /* _SUNXI_DRAM_SUN60IW2_H */
