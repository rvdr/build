+static void setbit(u32 cpux, u8 bit)
+{
+	u32 reg_val;
+	reg_val = readl(cpux);
+	reg_val |= (1 << bit);
+	writel(reg_val, cpux);
+}
+
+static void clearbit(u32 cpux, u8 bit)
+{
+	u32 reg_val;
+	reg_val = readl(cpux);
+	reg_val &= ~(1 << bit);
+	writel(reg_val, cpux);
+}
