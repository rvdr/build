+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * sun60iw2 (A733/T527) platform DRAM controller driver
+ * Reversed via IDA Pro from Allwinner boot0
+ * * Supports LPDDR5 memory.
+ */
+
+#include <init.h>
+#include <log.h>
+#include <asm/io.h>
+#include <asm/arch/clock.h>
+#include <asm/arch/dram.h>
+#include <asm/arch/dram_dw_helpers.h>
+#include <asm/arch/cpu.h>
+#include <asm/arch/prcm.h>
+#include <linux/bitops.h>
+#include <linux/delay.h>
+
+static void mctl_sys_init(u32 clk_rate)
+{
+	void * const ccm = (void *)SUNXI_CCM_BASE;
+
+	/* Put all DRAM-related blocks to reset state */
+	clrbits_le32(ccm + CCU_H6_MBUS_CFG, MBUS_ENABLE);
+	clrbits_le32(ccm + CCU_H6_MBUS_CFG, MBUS_RESET);
+	setbits_le32(ccm + CCU_H6_MBUS_CFG, MBUS_UPDATE);
+	clrbits_le32(ccm + CCU_H6_DRAM_GATE_RESET, BIT(GATE_SHIFT));
+	udelay(5);
+	clrbits_le32(ccm + CCU_H6_DRAM_GATE_RESET, BIT(RESET_SHIFT));
+	clrbits_le32(ccm + CCU_H6_PLL5_CFG, CCM_PLL_CTRL_EN);
+	clrsetbits_le32(ccm + CCU_H6_DRAM_CLK_CFG,
+					DRAM_CLK_ENABLE, DRAM_CLK_UPDATE);
+
+	udelay(5);
+
+	/* Set PLL5 rate to doubled DRAM clock rate */
+	writel(CCM_PLL_CTRL_EN | CCM_PLL_LDO_EN | CCM_PLL_LOCK_EN |
+		   CCM_PLL_OUT_EN | CCM_PLL5_CTRL_N(clk_rate * 2 / 24),
+		   ccm + CCU_H6_PLL5_CFG);
+	mctl_await_completion(ccm + CCU_H6_PLL5_CFG,
+						  CCM_PLL_LOCK, CCM_PLL_LOCK);
+
+	/* Configure DRAM mod clock */
+	writel(DRAM_CLK_SRC_PLL5, ccm + CCU_H6_DRAM_CLK_CFG);
+	writel(BIT(RESET_SHIFT), ccm + CCU_H6_DRAM_GATE_RESET);
+	udelay(5);
+	setbits_le32(ccm + CCU_H6_DRAM_GATE_RESET, BIT(GATE_SHIFT));
+
+	/* Configure MBUS and enable DRAM clock */
+	setbits_le32(ccm + CCU_H6_MBUS_CFG, MBUS_RESET | MBUS_UPDATE);
+	setbits_le32(ccm + CCU_H6_MBUS_CFG, MBUS_ENABLE | MBUS_UPDATE);
+
+	clrsetbits_le32(ccm + CCU_H6_DRAM_CLK_CFG, DRAM_CLK_M_MASK,
+					DRAM_CLK_ENABLE | DRAM_CLK_UPDATE | DRAM_CLK_M(4));
+	udelay(5);
+}
+
+static void mctl_set_addrmap(const struct dram_config *config)
+{
+	void * const mctl_ctl = (void *)SUNXI_DRAM_CTL0_BASE;
+	u8 cols = config->cols;
+	u8 rows = config->rows;
+	u8 ranks = config->ranks;
+
+	if (!config->bus_full_width)
+		cols -= 1;
+
+	/* Ranks (Offset 0x200) */
+	if (ranks == 2)
+		writel(0x1F00 | (rows + cols - 3), mctl_ctl + 0x200);
+	else
+		writel(0x1F1F, mctl_ctl + 0x200);
+
+	/* Banks, hardcoded to 8 banks now (Offset 0x204) */
+	writel((cols - 2) | (cols - 2) << 8 | (cols - 2) << 16, mctl_ctl + 0x204);
+
+	/* Columns (Offsets 0x208, 0x20C, 0x210) */
+	writel(0, mctl_ctl + 0x208);
+	switch (cols) {
+	case 7:
+		writel(0x1F1F1F00, mctl_ctl + 0x20C);
+		writel(0x1F1F, mctl_ctl + 0x210);
+		break;
+	case 8:
+		writel(0x1F1F0000, mctl_ctl + 0x20C);
+		writel(0x1F1F, mctl_ctl + 0x210);
+		break;
+	case 9:
+		writel(0x1F000000, mctl_ctl + 0x20C);
+		writel(0x1F1F, mctl_ctl + 0x210);
+		break;
+	case 10:
+		writel(0, mctl_ctl + 0x20C);
+		writel(0x1F1F, mctl_ctl + 0x210);
+		break;
+	case 11:
+		writel(0, mctl_ctl + 0x20C);
+		writel(0x1F00, mctl_ctl + 0x210);
+		break;
+	case 12:
+		writel(0, mctl_ctl + 0x20C);
+		writel(0, mctl_ctl + 0x210);
+		break;
+	default:
+		panic("Unsupported DRAM configuration: column number invalid\n");
+	}
+
+	/* Rows (Offsets 0x214, 0x218, 0x21C) */
+	writel((cols - 3) | ((cols - 3) << 8) | ((cols - 3) << 16) | ((cols - 3) << 24), mctl_ctl + 0x214);
+	switch (rows) {
+	case 13:
+		writel((cols - 3) | 0x0F0F0F00, mctl_ctl + 0x218);
+		writel(0x0F0F, mctl_ctl + 0x21C);
+		break;
+	case 14:
+		writel((cols - 3) | ((cols - 3) << 8) | 0x0F0F0000, mctl_ctl + 0x218);
+		writel(0x0F0F, mctl_ctl + 0x21C);
+		break;
+	case 15:
+		writel((cols - 3) | ((cols - 3) << 8) | ((cols - 3) << 16) | 0x0F000000, mctl_ctl + 0x218);
+		writel(0x0F0F, mctl_ctl + 0x21C);
+		break;
+	case 16:
+		writel((cols - 3) | ((cols - 3) << 8) | ((cols - 3) << 16) | ((cols - 3) << 24), mctl_ctl + 0x218);
+		writel(0x0F0F, mctl_ctl + 0x21C);
+		break;
+	case 17:
+		writel((cols - 3) | ((cols - 3) << 8) | ((cols - 3) << 16) | ((cols - 3) << 24), mctl_ctl + 0x218);
+		writel((cols - 3) | 0x0F00, mctl_ctl + 0x21C);
+		break;
+	case 18:
+		writel((cols - 3) | ((cols - 3) << 8) | ((cols - 3) << 16) | ((cols - 3) << 24), mctl_ctl + 0x218);
+		writel((cols - 3) | ((cols - 3) << 8), mctl_ctl + 0x21C);
+		break;
+	default:
+		panic("Unsupported DRAM configuration: row number invalid\n");
+	}
+
+	/* Bank groups, DDR4 only (Offset 0x220) */
+	writel(0x3F3F, mctl_ctl + 0x220);
+}
+
+/* * from IDA sub_25C34
+ * Initializes the individual Byte-Lanes of the PHY
+ */
+static void mctl_phy_lane_init(const struct dram_para *para, u32 ch)
+{
+	/* Offset for Channel 1 is 0x400000 */
+	u32 ch_offset = ch * 0x400000;
+	void *phy_base = (void *)(uintptr_t)(SUNXI_DRAM_PHY0_BASE + ch_offset);
+	void *ctl_base = (void *)(uintptr_t)(SUNXI_DRAM_CTL0_BASE + ch_offset);
+
+	clrsetbits_le32(phy_base + 0x280, 0x7F00, 0x3400);
+
+	/* Init the 4 Data Slices (Byte Lanes) */
+	writel(255, ctl_base + 0x000A00);
+	writel(255, ctl_base + 0x100C00); // Offset +0x100000
+	writel(255, ctl_base + 0x200C00); // Offset +0x100000
+	writel(255, ctl_base + 0x300C00); // Offset +0x100000
+}
+
+/* * from IDA sub_258C8
+ * Writes ODT, DRI and Delay parameters into the PHY SRAM mailbox
+ */
+static void mctl_phy_bit_delay_compensation(const struct dram_para *para, u32 ch)
+{
+	u32 ch_offset = ch * 0x400000;
+	void *sram_base = (void *)(uintptr_t)(SUNXI_DRAM_CTL0_BASE + ch_offset + 0x30000);
+
+	/* Using dram_para1 (offset 0x18 / 24 dezimal in boot0) */
+	u32 p1 = para->para1;
+	u8 v4 = p1 & 0xF;
+	u8 v5 = (p1 >> 4) & 0xFF;
+	u8 v6 = (p1 >> 12) & 3;
+	u16 v7 = p1 >> 14;
+	u32 v8 = v7 << 8;
+	u32 v9 = (v7 << 8) | (v7 << 16);
+
+	/* * Flag: Entspricht MEMORY[0x66C18] aus boot0. 
+	 * Oft genutzt für Half-DQ / spezielles Die-Routing. Standardmäßig false.
+	 */
+	bool flag = false;
+
+	/* Write to offset 0x18 (IDA: v3[42254342]) */
+	u32 val_0x18 = v9 | (v7 << 24);
+	if (flag) val_0x18 = 0;
+	writel(val_0x18, sram_base + 0x18);
+
+	/* Write to offset 0x14 (IDA: v3[42254341]) */
+	u32 val_0x14;
+	switch (v4) {
+		case 8:  val_0x14 = v7 | 0x1F1F1F00; break;
+		case 9:  val_0x14 = v7 | 0x1F1F0000 | v8; break; // LPDDR5
+		case 10: val_0x14 = v7 | 0x1F000000 | v8 | (v7 << 16); break;
+		default: val_0x14 = (v7 << 24) | v7 | v9; break;
+	}
+	if (v4 == 10 && flag) val_0x14 = 520093696;
+	writel(val_0x14, sram_base + 0x14);
+
+	/* Write to offset 0x10 (IDA: v3[42254340]) */
+	u32 val_0x10;
+	if (v7 == 2) {
+		val_0x10 = flag ? 2313 : 257;
+	} else {
+		val_0x10 = (v7 == 1) ? 16129 : 16191;
+		if (flag && v7 == 1) val_0x10 = 16137;
+	}
+	writel(val_0x10, sram_base + 0x10);
+
+	/* Write to offset 0x0C (IDA: v3[42254339]) */
+	u32 v13 = v4 - 3 + v7;
+	u32 v14 = v13 << 8;
+	u32 val_0x0c;
+	if (v6 == 3) {
+		val_0x0c = v14 | (v13 << 16) | v13;
+	} else {
+		val_0x0c = flag ? ((v4 - 3) | 0x3F0000 | ((v4 - 3) << 8)) : (v13 | 0x3F0000 | v14);
+	}
+	writel(val_0x0c, sram_base + 0x0C);
+
+	/* Calculate v16 for delays (IDA: v3[42254347] to v3[42254344]) */
+	u32 v16 = v7 + v6 + v4;
+	u32 v17 = (v16 - 6) | ((v16 - 6) << 8);
+	u32 v18 = v17 | ((v16 - 6) << 16);
+	u32 v19 = v18 | ((v16 - 6) << 24);
+
+	writel(v17, sram_base + 0x2C);
+	writel(v19, sram_base + 0x28);
+	writel(v19, sram_base + 0x24);
+	writel(v19, sram_base + 0x20);
+
+	/* Write to offset 0x1C - Drive Strength (IDA: v3[42254343]) */
+	u32 val_0x1c;
+	switch (v5) {
+		case 14: val_0x1c = 0x1F1F1F1F; break; /* 522133279 = 0x1F1F1F1F */
+		case 15: val_0x1c = (v16 - 6) | 0x1F1F1F00; break;
+		case 16: val_0x1c = v17 | 0x1F1F0000; break;
+		case 17: val_0x1c = v18 | 0x1F000000; break;
+		default: val_0x1c = v19; break;
+	}
+	writel(val_0x1c, sram_base + 0x1C);
+
+	/* Write to offset 0x04 - Delay mapping (IDA: v3[42254337]) */
+	u32 val_0x04;
+	/* *(_DWORD *)(result + 28) == para->para2 */
+	if (para->para2 & 0x1000) {
+		val_0x04 = v5 - 6;
+		val_0x04 = (val_0x04 + v16) | 0x3F00;
+	} else {
+		val_0x04 = 16191;
+	}
+	writel(val_0x04, sram_base + 0x04);
+}
+
+/* * from IDA sub_25AD8
+ * Main DFI and Controller Initialization per channel
+ */
+static void mctl_ctrl_init_channel(const struct dram_para *para, const struct dram_config *config, u32 ch)
+{
+	u32 ch_offset = ch * 0x400000;
+	void *phy_base = (void *)(uintptr_t)(SUNXI_DRAM_PHY0_BASE + ch_offset);
+
+	if (para->type == 9) {
+		clrsetbits_le32(phy_base + 0x10, 0x101, 1); // MSTR
+	}
+
+	clrbits_le32(phy_base + 0x18C, 0x3F); // INIT3
+	clrsetbits_le32(phy_base + 0x180, 0x8FF, 0x800); // INIT0
+
+	writel(0x110111, phy_base + 0x500); // DFITMG0
+	writel(0xC0000000, phy_base + 0x508); // DFITMG1 (Base value)	
+
+	u32 odtcfg = readl(phy_base + 0x280);
+	if (para->type == 9) {
+		writel((odtcfg & 0xDFFFFFFF) | 0x80000000, phy_base + 0x280);
+		writel((readl(phy_base + 0x300) & 0xFF00FF00) | 0xC000C0, phy_base + 0x300);
+	}
+
+	setbits_le32(phy_base + 0x288, 1); // ODTMAP
+	setbits_le32(phy_base + 0x308, 1); // SCHED0
+	setbits_le32(phy_base + 0x508, 1); // DFITMG1
+
+	clrsetbits_le32(phy_base + 0x510, 0x30015, 0x10015); // DFIMISC
+
+	/* Write Delay Compensation into SRAM */
+	mctl_phy_bit_delay_compensation(para, ch);
+
+	mctl_set_addrmap(config);
+
+	/* Set Timing Parameters (This function calls your already decoded sub_25198) */
+	mctl_set_timing_params(config);
+
+	/* DFI Init Toggle */
+	if (para->type == 9) {
+		clrbits_le32(phy_base + 0xB84, 1);
+		writel(0, phy_base + 0xC80); // swctl = 0
+
+		clrsetbits_le32(phy_base + 0x510, 0x30015, 0x10004); // dfimisc
+		writel(1, phy_base + 0xC80); // swctl = 1
+		while ((readl(phy_base + 0xC84) & 1) == 0); // wait swstat
+
+		writel(0, phy_base + 0xC80);
+		clrsetbits_le32(phy_base + 0x510, 0x30015, 0x10014); // dfimisc
+		writel(1, phy_base + 0xC80);
+		while ((readl(phy_base + 0xC84) & 1) == 0);
+	}
+}
+
+/*
+ * from IDA sub_250B4
+ * Finalizes training and configures NSI Bus QoS
+ */
+static void sunxi_post_training_and_nsi_init(const struct dram_para *para)
+{
+	void *nsi_base = (void *)(uintptr_t)SUNXI_NSI_BASE;
+	void *axi_hif0 = (void *)(uintptr_t)SUNXI_CPU_AXI2HIF0_BASE; 
+	void *axi_hif1 = (void *)(uintptr_t)SUNXI_CPU_AXI2HIF1_BASE;
+	int channels;
+	int i;
+
+	/* Use logic from the decompiler to determine the number of channels */
+	if (para->tpr13 & 0x40) {
+		channels = 2;
+	} else {
+		channels = 1;
+	}
+
+	/* Trigger swctl for all active channels */
+	for (i = 0; i < channels; i++) {
+		writel(0, (void *)(uintptr_t)(SUNXI_DRAM_PHY0_BASE + (i * 0x400000) + 0xC80));
+	}
+	for (i = 0; i < channels; i++) {
+		writel(0, (void *)(uintptr_t)(SUNXI_DRAM_PHY0_BASE + (i * 0x400000) + 0x208)); // rfshctl3
+	}
+	for (i = 0; i < channels; i++) {
+		writel(1, (void *)(uintptr_t)(SUNXI_DRAM_PHY0_BASE + (i * 0x400000) + 0xC80));
+	}
+	for (i = 0; i < channels; i++) {
+		while ((readl((void *)(uintptr_t)(SUNXI_DRAM_PHY0_BASE + (i * 0x400000) + 0xC84)) & 1) == 0);
+	}
+
+	if (channels == 2) {
+		writel(32770, nsi_base + 0x4818);
+		writel(0xFFFFFFFF, nsi_base + 0x481C);
+		
+		/* Replaced hard-coded addresses with macros */
+		writel(32770, axi_hif0 + 0x18);
+		writel(32770, axi_hif1 + 0x18);
+		writel(0xFFFFFFFF, axi_hif0 + 0x68);
+		writel(0xFFFFFFFF, axi_hif1 + 0x68);
+
+		writel(2, nsi_base + 0x4838);
+		writel(2, nsi_base + 0x448C);
+		writel(2, nsi_base + 0x468C);
+	} else {
+		writel(1, nsi_base + 0x44A8);
+		writel(1, nsi_base + 0x46A8);
+
+		/* Replaced hard-coded addresses with macros */
+		writel(3, axi_hif0 + 0x08);
+		writel(3, axi_hif1 + 0x08);
+	}
+}
+
+/* * from IDA sub_25C6C
+ * Main Entry Point for Core Controller
+ */
+bool mctl_core_init(const struct dram_para *para, const struct dram_config *config)
+{
+	void * const mctl_com = (void *)SUNXI_DRAM_COM_BASE;
+	int dual_channel = 1;
+
+	/* * Check FEX para + 120 (Offset 0x78) for bit 0x40
+	 * Assuming this maps to tpr13 in our struct based on the 8G/6G FEX values
+	 */
+	if (para->tpr13 & 0x40) {
+		dual_channel = 2;
+	}
+
+	u32 com_reg10 = readl(mctl_com + 0x10) & 0xFFFFC0C0;
+	writel((dual_channel == 2) ? (com_reg10 | 0x2728) : (com_reg10 | 0x2208), mctl_com + 0x10);
+
+	u32 com_reg14 = readl(mctl_com + 0x14) & 0xFFFFFFFC;
+	if (dual_channel == 2) com_reg14 |= 2;
+	if (para->type == 9) com_reg14 |= 1; // Enable LPDDR5
+	writel(com_reg14, mctl_com + 0x14);
+
+	writel(5119, mctl_com + 0x220);
+	writel(5119, mctl_com + 0x228);
+	writel(263, mctl_com + 0x21C);
+	writel(263, mctl_com + 0x224);
+
+	/* PRCM / CPUCFG Block */
+	setbits_le32(0x07010250, 1);
+
+	/* Initialize Channel 0 */
+	mctl_phy_lane_init(para, 0);
+	if (para->type == 9) setbits_le32(SUNXI_DRAM_PHY0_BASE + 0xB84, 1);
+	writel(2, SUNXI_DRAM_PHY0_BASE + 0x184);
+	mctl_ctrl_init_channel(para, config, 0);
+
+	/* Initialize Channel 1 (if enabled) */
+	if (dual_channel == 2) {
+		mctl_phy_lane_init(para, 1);
+		if (para->type == 9) setbits_le32(SUNXI_DRAM_PHY1_BASE + 0xB84, 1);
+		writel(2, SUNXI_DRAM_PHY1_BASE + 0x184);
+		mctl_ctrl_init_channel(para, config, 1);
+	}
+
+	u32 v9 = (readl(mctl_com + 0x10) & 0xFFFFFFEB) | ((dual_channel == 2) ? 0x14 : 4);
+	writel((v9 & 0xFFFFFFFC) | 2, mctl_com + 0x10);
+	udelay(1); // sub_21D80(1) usually maps to delay
+	setbits_le32(mctl_com + 0x10, 3);
+	udelay(1);
+
+	/* Execute PHY Training (Placeholder for sub_25058) */
+	// bool result = mctl_phy_training_main(para, config);
+	bool result = true; // Assume success for this skeleton
+
+	if (result) {
+		/* Optional: adjust clock or reset NSI based on training success */
+		sunxi_post_training_and_nsi_init(para);
+		return true;
+	}
+
+	return false;
+}
+
+static const struct dram_para para = {
+	.type = SUNXI_DRAM_TYPE_LPDDR5,
+	.dram_clk = CONFIG_DRAM_CLK,
+	.dx_odt = CONFIG_DRAM_SUNXI_DX_ODT,
+	.dx_dri = CONFIG_DRAM_SUNXI_DX_DRI,
+	.ca_dri = CONFIG_DRAM_SUNXI_CA_DRI,
+	.para1  = 0xa10a,	   /* Hardcoded from FEX: cxmt 6g ddr */
+	.tpr0 = CONFIG_DRAM_SUNXI_TPR0,
+	.tpr1 = CONFIG_DRAM_SUNXI_TPR1,
+	.tpr6 = CONFIG_DRAM_SUNXI_TPR6,
+	.tpr10 = CONFIG_DRAM_SUNXI_TPR10,
+	.tpr11 = CONFIG_DRAM_SUNXI_TPR11,
+	.tpr12 = CONFIG_DRAM_SUNXI_TPR12,
+	.tpr13 = 0x10065,	   /* Hardcoded from FEX: Controls dual-channel mode */
+	.tpr14 = 0x0,
+};
+
+unsigned long sunxi_dram_init(void)
+{
+	struct dram_config config;
+	unsigned long size;
+
+	mctl_sys_init(para.dram_clk);
+
+	config.clk = 360;
+	
+	switch (para.type) {
+	case SUNXI_DRAM_TYPE_LPDDR4:
+		config.odt_en = 0x84848484;
+		config.tpr11 = 0x9a9a9a9a;
+		config.tpr12 = 0x0e0f070a;
+		config.tpr14 = 0x48484848;
+		break;
+	case SUNXI_DRAM_TYPE_LPDDR5:
+		config.odt_en = 0x0;
+		config.tpr11 = 0x0;
+		config.tpr12 = 0x0;
+		config.tpr14 = 0x0;
+		break;
+	default:
+		panic("This DRAM setup is currently not supported.\n");
+	};
+
+	setbits_le32(0x03000160, BIT(8));
+	clrbits_le32(0x03000168, 0x3f);
+
+	mctl_auto_detect_rank_width(&para, &config);
+	mctl_auto_detect_dram_size(&para, &config);
+
+	config.clk = CONFIG_DRAM_CLK;
+#ifdef CONFIG_DRAM_SUNXI_ODT_EN
+	config.odt_en = CONFIG_DRAM_SUNXI_ODT_EN;
+#endif
+	config.tpr11 = CONFIG_DRAM_SUNXI_TPR11;
+	config.tpr12 = CONFIG_DRAM_SUNXI_TPR12;
+
+	mctl_core_init(&para, &config);
+
+	size = mctl_calc_size(&config);
+
+	int dual_channel = (para.tpr13 & 0x40) ? 2 : 1;
+	sunxi_post_training_and_nsi_init(&para);
+
+	return size;
+}
diff --git a/arch/arm/mach-sunxi/dram_timings/a733_lpddr5.c b/arch/arm/mach-sunxi/dram_timings/a733_lpddr5.c
new file mode 100644
index 000000000000..111111111111
--- /dev/null
+++ b/arch/arm/mach-sunxi/dram_timings/a733_lpddr5.c
@@ -0,0 +1,121 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * sun60iw2 (A733/T527) LPDDR5 timings, as programmed by Allwinner's boot0
+ * Reversed via IDA Pro
+ */
+
+#include <asm/arch/dram.h>
+#include <asm/arch/cpu.h>
+#include <linux/bitops.h>
+
+void mctl_set_timing_params(const struct dram_config *config)
+{
+	void * const mctl_ctl = (void *)SUNXI_DRAM_CTL0_BASE;
+
+	/* * In boot0, DFI clock is clk / 4 for LPDDR5 calculation
+	 * (v12 = *a1 >> 2 in IDA)
+	 */
+	u32 dfi_clk = config->clk / 4;
+
+	/* * flag: corresponds to MEMORY[0x66C18] in boot0.
+	 * This is a hardware/FEX specific switch (likely indicating CXMT die
+	 * or half-width mode). Set to false by default, patch if needed.
+	 */
+	bool flag = false;
+
+	/* Timing calculations (ns_to_t converts ns to ticks) */
+	u8 tfaw	  = max((u32)ns_to_t(40, dfi_clk), 8u);
+	u8 t_20	  = ns_to_t(20, dfi_clk);
+	u8 t_5	   = max((u32)ns_to_t(5, dfi_clk), 2u);
+	u8 t_18	  = max((u32)ns_to_t(18, dfi_clk), 2u);
+	u8 t_7	   = max((u32)ns_to_t(7, dfi_clk), 3u);
+	u8 t_12_14   = ns_to_t(flag ? 14 : 12, dfi_clk);
+	u8 t_8	   = max((u32)ns_to_t(8, dfi_clk), 2u);
+	u8 t_21	  = max((u32)ns_to_t(21, dfi_clk), 2u);
+	u8 t_42	  = max((u32)ns_to_t(42, dfi_clk), 3u);
+	u16 trefi	= ns_to_t(3906, dfi_clk);
+	u16 trfc	 = ns_to_t(380, dfi_clk);
+	u16 t_260	= ns_to_t(260, dfi_clk);
+	u16 t_90	 = ns_to_t(90, dfi_clk);
+	u8 t_3	   = ns_to_t(3, dfi_clk);
+	u8 t_15	  = max((u32)ns_to_t(15, dfi_clk), 2u);
+
+	u32 t_200us  = ns_to_t(200000, dfi_clk);
+	u32 ceil_200 = ((t_200us & 0x3FF) != 0) + (t_200us / 1024);
+	u32 trasmax  = 9 * (trefi / 32);
+
+	u8 v58 = max((u32)t_12_14, 4u);
+	u8 v62 = flag ? t_8 + 2 : t_8;
+	u8 v80 = t_21 + t_42;
+	u8 v55 = trfc + t_8;
+	u8 v88 = t_5 + 1;
+	u8 v72 = ns_to_t(10, dfi_clk) + 1;
+	u8 v90 = flag ? 8 : 16;
+	u8 v87 = max((u32)t_5, 3u);
+	u8 v86 = trasmax / 32;
+	u8 v5  = flag ? 10 : 12;
+	u8 v76 = v58 + (flag ? 9 : 11);
+	u8 v89 = max((u32)t_7, 4u) + 9;
+	u8 v92 = flag ? 16 : 18;
+
+	u8 v52 = max((u32)t_8, 4u);
+	u8 v53 = v52 + 13 + v62;
+	u32 v11 = flag ? v52 + 30 : v52 + 32;
+	u32 v71 = flag ? v53 + 4 : v53 + 6;
+
+	/* Hardcoded LPDDR5 state machine constants */
+	u32 v66 = 31, v63 = 10, v77 = 10, v67 = 2, v70 = 7;
+	u32 v57 = 3,  v59 = 47, v69 = 3,  v64 = v5, v8 = 13;
+	
+	u32 v10 = 23 | (flag ? 0x180000 : 0);
+	u32 v68 = 5;
+
+	/* 1. MCTL DRAM Timing Registers (dramtmg0 - dramtmg14) */
+	writel((t_20 << 16) | (v66 << 24) | t_42 | (v86 << 8), mctl_ctl + 0x00);
+	writel((v62 << 8) | (t_7 << 16) | v80, mctl_ctl + 0x04);
+	writel((v8 << 16) | (v70 << 24) | v76 | (v5 << 8), mctl_ctl + 0x08);
+	writel((v11 | 0xA0000) | (v71 << 8), mctl_ctl + 0x0C);
+	
+	writel(((flag ? 2u : 4u) << 16) | (t_18 << 24) | t_21 | (t_5 << 8), mctl_ctl + 0x10); 
+	
+	writel((v87 << 16) | (v67 << 24) | v72 | (t_15 << 8), mctl_ctl + 0x14);
+	writel(t_7 + 2, mctl_ctl + 0x18);
+	writel(t_3, mctl_ctl + 0x1C);
+	writel(v89 | 0x20000 | (v88 << 8), mctl_ctl + 0x24);
+	writel(196608, mctl_ctl + 0x30);
+	writel((v90 << 16) | (v63 << 24) | v67, mctl_ctl + 0x34);
+	writel(v55 | (tfaw << 16), mctl_ctl + 0x38);
+	writel(v72 | (ceil_200 << 16), mctl_ctl + 0x5C);
+	writel((v92 << 8) | (v77 << 16) | v64, mctl_ctl + 0x60);
+
+	/* 2. Hardware / Misc Config */
+	writel((v59 << 16) | (flag ? 0x3000200 : 0x2000200) | v10, mctl_ctl + 0x580);
+	writel(459523, mctl_ctl + 0x584); 
+	writel(v10 | (v59 << 8), mctl_ctl + 0x588); 
+	
+	writel(((v69 - 1) << 18) | ((v68 - 1) << 26) | 0x11, mctl_ctl + 0x590);
+	writel((v57 << 18) | 0x400000F, mctl_ctl + 0x594);
+
+	/* 3. LPDDR5 Specific Init Blocks */
+	writel(131586, mctl_ctl + 0x5A0);
+	writel(513, mctl_ctl + 0x5A4);
+	writel(1835011, mctl_ctl + 0x5A8);
+	writel(5767328, mctl_ctl + 0x5AC);
+	writel(151, mctl_ctl + 0x5B0);
+	writel(327, mctl_ctl + 0x5B8);
+
+	/* 4. Refresh & ZQ Registers */
+	clrsetbits_le32(mctl_ctl + 0x600, 0x8000FFFF, (trefi / 32));
+	clrsetbits_le32(mctl_ctl + 0x604, 0x0FFF0FFF, trfc | (trfc << 16));
+	clrsetbits_le32(mctl_ctl + 0x608, 0xFFFF0000, (t_90 << 16) | (t_8 << 24));
+	clrsetbits_le32(mctl_ctl + 0x650, 0x00000FFF, t_260);
+
+	/* 5. DFI / Internal PHY setup */
+	writel(1574102, mctl_ctl + 0x800);
+	writel(41943127, mctl_ctl + 0x804);
+	writel(8052, mctl_ctl + 0xA80);
+	writel(130073570, mctl_ctl + 0xB00);
+	writel(270798858, mctl_ctl + 0xB04);
+	writel(51, mctl_ctl + 0xB08);
+	writel(1507328, mctl_ctl + 0xB80);
+}
