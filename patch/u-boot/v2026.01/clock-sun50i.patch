From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: John Doe <john.doe@somewhere.on.planet>
Date: Tue, 31 Mar 2026 10:30:50 +0200
Subject: Patching u-boot sunxi64 files arch/arm/mach-sunxi/clock_sun50i_h6.c

Signed-off-by: John Doe <john.doe@somewhere.on.planet>
---
 arch/arm/mach-sunxi/clock_sun50i_h6.c | 30 +++++++++-
 1 file changed, 29 insertions(+), 1 deletion(-)

diff --git a/arch/arm/mach-sunxi/clock_sun50i_h6.c b/arch/arm/mach-sunxi/clock_sun50i_h6.c
index 80004f13a1e..c0daf04ebb4 100644
--- a/arch/arm/mach-sunxi/clock_sun50i_h6.c
+++ b/arch/arm/mach-sunxi/clock_sun50i_h6.c
@@ -4,10 +4,22 @@
 #include <asm/arch/cpu.h>
 #include <asm/arch/clock.h>
 #include <asm/arch/prcm.h>
 #include <linux/delay.h>
 
+#if IS_ENABLED(CONFIG_MACH_SUN60I_A733)
+#include <asm/arch/timer.h>
+#include <usb.h>
+
+#define CCM_PLL6_DEFAULT          0xa0006300
+#define CCM_PSI_AHB1_AHB2_DEFAULT 0x03000102
+#define CCM_APB1_DEFAULT          0x03000102
+#define RTC_XO_CONTROL0_REG        	0x0160
+#define HOSC_19_2M			(BIT(14))
+#define HOSC_26M			(BIT(15))
+#endif
+
 #ifndef SUNXI_CPU_PLL_CFG_BASE
 #define SUNXI_CPU_PLL_CFG_BASE 0
 #endif
 
 #ifdef CONFIG_XPL_BUILD
@@ -76,10 +88,13 @@ void clock_init_safe(void)
 
 void clock_init_uart(void)
 {
 	void *const ccm = (void *)SUNXI_CCM_BASE;
 
+	if (IS_ENABLED(CONFIG_MACH_SUN60I_A733))
+		return;
+
 	/* uart clock source is apb2 */
 	writel(APB2_CLK_SRC_OSC24M|
 	       APB2_CLK_RATE_N_1|
 	       APB2_CLK_RATE_M(1),
 	       ccm + CCU_H6_APB2_CFG);
@@ -197,11 +212,11 @@ void clock_set_pll1(unsigned int clk)
 	if (clk < 288000000)
 		clk = 288000000;
 
 	clk /= 24000000;
 
-	if (IS_ENABLED(CONFIG_MACH_SUN55I_A523))
+	if (IS_ENABLED(CONFIG_MACH_SUN55I_A523) || IS_ENABLED(CONFIG_MACH_SUN60I_A733))
 		clock_a523_set_cpu_plls(clk);
 	else
 		clock_h6_set_cpu_pll(clk);
 }
 
@@ -230,10 +245,26 @@ int clock_twi_onoff(int port, int state)
 
 	return 0;
 }
 #endif /* CONFIG_XPL_BUILD */
 
+#if IS_ENABLED(CONFIG_MACH_SUN60I_A733)
+uint get_hosc(void)
+{
+	u32 reg_val;
+	/* ACHTUNG: SUNXI_RTC_BASE muss in arch/cpu.h definiert sein (oft 0x07000000) */
+	reg_val = readl(SUNXI_RTC_BASE + RTC_XO_CONTROL0_REG);
+
+	if (reg_val & HOSC_19_2M)
+		return 19200000;
+	else if (reg_val & HOSC_26M)
+		return 26000000;
+	else
+		return 24000000;
+}
+#endif /* CONFIG_MACH_SUN60I_A733 */
+
 /* PLL_PERIPH0 clock, used by the MMC driver */
 unsigned int clock_get_pll6(void)
 {
 	void *const ccm = (void *)SUNXI_CCM_BASE;
 	uint32_t rval = readl(ccm + CCU_H6_PLL6_CFG);
-- 
