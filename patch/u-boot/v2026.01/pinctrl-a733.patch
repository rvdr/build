From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: John Doe <john.doe@somewhere.on.planet>
Date: Sat, 4 Apr 2026 16:27:49 +0000
Subject: Patching u-boot sunxi64 files drivers/pinctrl/sunxi/Kconfig
 drivers/pinctrl/sunxi/pinctrl-sunxi.c

Signed-off-by: John Doe <john.doe@somewhere.on.planet>
---
 drivers/pinctrl/sunxi/Kconfig         | 10 ++
 drivers/pinctrl/sunxi/pinctrl-sunxi.c | 60 ++++++++++
 2 files changed, 70 insertions(+)

diff --git a/drivers/pinctrl/sunxi/Kconfig b/drivers/pinctrl/sunxi/Kconfig
index 54314992299..49e195143d8 100644
--- a/drivers/pinctrl/sunxi/Kconfig
+++ b/drivers/pinctrl/sunxi/Kconfig
@@ -146,7 +146,17 @@ config PINCTRL_SUN55I_A523
 
 config PINCTRL_SUN55I_A523_R
 	bool "Support for the Allwinner A523 R-PIO"
 	default MACH_SUN55I_A523
 	select PINCTRL_SUNXI
+	
+config PINCTRL_SUN60I_A733
+	bool "Support for the Allwinner A733 PIO"
+	default MACH_SUN60I_A733
+	select PINCTRL_SUNXI
+
+config PINCTRL_SUN60I_A733_R
+	bool "Support for the Allwinner A733 R-PIO"
+	default MACH_SUN60I_A733
+	select PINCTRL_SUNXI
 
 endif
diff --git a/drivers/pinctrl/sunxi/pinctrl-sunxi.c b/drivers/pinctrl/sunxi/pinctrl-sunxi.c
index fd357ab0d4e..eb48130b5d4 100644
--- a/drivers/pinctrl/sunxi/pinctrl-sunxi.c
+++ b/drivers/pinctrl/sunxi/pinctrl-sunxi.c
@@ -780,10 +780,42 @@ static const struct sunxi_pinctrl_desc __maybe_unused sun55i_a523_pinctrl_desc =
 	.num_functions	= ARRAY_SIZE(sun55i_a523_pinctrl_functions),
 	.first_bank	= SUNXI_GPIO_A,
 	.num_banks	= 11,
 };
 
+static const struct sunxi_pinctrl_function sun60i_a733_pinctrl_functions[] = {
+	{ "gpio_in",	0 },
+	{ "gpio_out",	1 },
+	{ "mmc0",	2 },	/* PF0-PF5 */
+	{ "sdc0",	2 },	/* PF0-PF5 (Allwinner BSP name) */
+	{ "mmc1",	2 },	/* PG0-PG5 */
+	{ "sdc1",	2 },	/* PG0-PG5 (Allwinner BSP name) */
+	{ "mmc2",	3 },	/* PC0-PC16 */
+	{ "sdc2",	3 },	/* PC0-PC16 (Allwinner BSP name) */
+	{ "mmc3",	4 },	/* PC0-PC16 */
+	{ "sdc3",	4 },	/* PC0-PC16 (Allwinner BSP name) */
+	{ "spi0",	5 },	/* PC2-PC7, PF24-PF31 */
+#if IS_ENABLED(CONFIG_UART0_PORT_F)
+	{ "uart0",	3 },	/* PF2-PF4 */
+#else
+	{ "uart0",	2 },	/* PB9-PB10 */
+#endif
+	{ "uart1",	2 },	/* PB10-PB11, PG6-PG7 */
+	{ "uart2",	2 },	/* PB0-PB3 */
+	{ "uart3",	2 },	/* PH4-PH7 */
+	{ "twi0",	2 },	/* PH0-PH1 */
+	{ "twi1",	2 },	/* PH2-PH3 */
+	{ "rgmii0",	5 },	/* PH0-PH19 (GMAC0) */
+};
+
+static const struct sunxi_pinctrl_desc __maybe_unused sun60i_a733_pinctrl_desc = {
+	.functions	= sun60i_a733_pinctrl_functions,
+	.num_functions	= ARRAY_SIZE(sun60i_a733_pinctrl_functions),
+	.first_bank	= SUNXI_GPIO_A,
+	.num_banks	= 11,	/* Bank A bis Bank K */
+};
+
 static const struct sunxi_pinctrl_function sun50i_h616_r_pinctrl_functions[] = {
 	{ "gpio_in",	0 },
 	{ "gpio_out",	1 },
 	{ "s_i2c",	3 },	/* PL0-PL1 */
 	{ "s_rsb",	2 },	/* PL0-PL1 */
@@ -845,10 +877,26 @@ static const struct sunxi_pinctrl_desc __maybe_unused sun55i_a523_r_pinctrl_desc
 	.num_functions	= ARRAY_SIZE(sun55i_a523_r_pinctrl_functions),
 	.first_bank	= SUNXI_GPIO_L,
 	.num_banks	= 2,
 };
 
+static const struct sunxi_pinctrl_function sun60i_a733_r_pinctrl_functions[] = {
+	{ "gpio_in",	0 },
+	{ "gpio_out",	1 },
+	{ "s_twi0",	2 },	/* PL0-PL1 */
+	{ "s_uart1",	2 },	/* PL2-PL3 */
+	{ "s_uart0",	3 },	/* PL2-PL3 */
+	{ "s_spi0",	4 },	/* PL4-PL7 */
+};
+
+static const struct sunxi_pinctrl_desc __maybe_unused sun60i_a733_r_pinctrl_desc = {
+	.functions	= sun60i_a733_r_pinctrl_functions,
+	.num_functions	= ARRAY_SIZE(sun60i_a733_r_pinctrl_functions),
+	.first_bank	= SUNXI_GPIO_L,
+	.num_banks	= 2,	/* Bank L und M */
+};
+
 static const struct udevice_id sunxi_pinctrl_ids[] = {
 #ifdef CONFIG_PINCTRL_SUNIV_F1C100S
 	{
 		.compatible = "allwinner,suniv-f1c100s-pinctrl",
 		.data = (ulong)&suniv_f1c100s_pinctrl_desc,
@@ -1031,10 +1079,22 @@ static const struct udevice_id sunxi_pinctrl_ids[] = {
 #ifdef CONFIG_PINCTRL_SUN55I_A523_R
 	{
 		.compatible = "allwinner,sun55i-a523-r-pinctrl",
 		.data = (ulong)&sun55i_a523_r_pinctrl_desc,
 	},
+#endif
+#ifdef CONFIG_PINCTRL_SUN60I_A733
+	{
+		.compatible = "allwinner,sun60i-a733-pinctrl",
+		.data = (ulong)&sun60i_a733_pinctrl_desc,
+	},
+#endif
+#ifdef CONFIG_PINCTRL_SUN60I_A733_R
+	{
+		.compatible = "allwinner,sun60i-a733-r-pinctrl",
+		.data = (ulong)&sun60i_a733_r_pinctrl_desc,
+	},
 #endif
 	{}
 };
 
 U_BOOT_DRIVER(sunxi_pinctrl) = {
