diff --git a/configs/orange-pi-4-pro_defconfig b/configs/orange-pi-4-pro_defconfig
new file mode 100644
index 000000000000..111111111111
--- /dev/null
+++ b/configs/orange-pi-4-pro_defconfig
@@ -0,0 +1,35 @@
+CONFIG_ARM=y
+CONFIG_ARCH_SUNXI=y
+CONFIG_DEFAULT_DEVICE_TREE="allwinner/sun60i-a733-orangepi-4-pro"
+CONFIG_SPL=y
+CONFIG_SYS_SDRAM_BASE=0x40000000
+CONFIG_SYS_INIT_RAM_ADDR=0x40000000
+CONFIG_SYS_INIT_RAM_SIZE=0x200000
+CONFIG_SYS_LOAD_ADDR=0x42000000
+CONFIG_DRAM_SUNXI_DX_ODT=0x00000000
+CONFIG_DRAM_SUNXI_DX_DRI=0x00000000
+CONFIG_DRAM_SUNXI_CA_DRI=0x0000
+CONFIG_DRAM_SUNXI_ODT_EN=0x00000000
+CONFIG_DRAM_SUNXI_TPR0=0x00000000
+CONFIG_DRAM_SUNXI_TPR1=0x00000000
+CONFIG_DRAM_SUNXI_TPR6=0x00000000
+CONFIG_DRAM_SUNXI_TPR10=0x00000000
+CONFIG_DRAM_SUNXI_TPR11=0x00000000
+CONFIG_DRAM_SUNXI_TPR12=0x00000000
+CONFIG_MACH_SUN60I_A733=y
+CONFIG_MMC_SUNXI_SLOT_EXTRA=2
+CONFIG_R_I2C_ENABLE=y
