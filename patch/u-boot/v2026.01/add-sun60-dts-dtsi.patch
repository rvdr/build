+/*
+ * Allwinner Technology CO., Ltd. sun60iw2p1 soc board.
+ *
+ * soc board support.
+ */
+
+#include <dt-bindings/gpio/gpio.h>
+#include "sun60i-a733.dtsi"
+
+/ {
+	model = "Radxa Cubie A7A";
+	compatible = "allwinner,a733", "arm,sun60iw2p1";
+
+	aliases:aliases@45100000 {
+		pwmchip0 = &pwmchip0;
+		pwmchip1 = &pwmchip1;
+		pwmchip2 = &pwmchip2;
+		pwm0 = &pwm0;
+		pwm1 = &pwm1;
+		pwm2 = &pwm2;
+		pwm3 = &pwm3;
+		pwm4 = &pwm4;
+		pwm16 = &pwm16;
+		pwm19 = &pwm19;
+		twi6 = &twi6;
+		pmu0 = &pmu0;
+		spi0 = &spi0;
+		ethernet0 = &gmac0;
+		ethernet1 = &gmac1;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";  /* <--- HIER sind die 115200 Baud! */
+	};
+};
+
+&platform {
+	eraseflag   = <1>;
+	next_work   = <3>;
+	debug_mode  = <4>;
+};
+
+&target {
+	boot_clock = <1008>;	/*CPU boot frequency, Unit: MHz*/
+	storage_type = <0xffffffff>; /*boot medium, 0-nand, 1-card0, 2-card2, -1(defualt)auto scan*/
+	burn_key = <1>;		/*1:support burn key; 0:not support burn key*/
+	dragonboard_test = <0>;	/*1:support card boot dragonboard; 0:not support card boot dragonboard*/
+};
+
+&power_sply {
+	ntc_status = <2>;
+	battery_exist = <0>;
+};
+
+&charger0 {
+	pmu_safe_vol = <3400>;
+	bat_bmp_type = <1>;
+	ntc_cur = <60>;
+	safe_temp_H = <600>;//60
+	safe_temp_L = <0xFFFFFFCE>;//-5
+	pmu_bat_temp_para1 = <4541>; //Murata -25
+	pmu_bat_temp_para2 = <2762>; //-15
+	pmu_bat_temp_para3 = <2180>; //-10
+	pmu_bat_temp_para4 = <1732>; //-5
+	pmu_bat_temp_para5 = <1386>;//0
+	pmu_bat_temp_para6 = <1117>; //5
+	pmu_bat_temp_para7 = <905>; //10
+	pmu_bat_temp_para8 = <606>; //20
+	pmu_bat_temp_para9 = <414>; //30
+	pmu_bat_temp_para10 = <290>; //40
+	pmu_bat_temp_para11 = <244>; //45
+	pmu_bat_temp_para12 = <205>; //50
+	pmu_bat_temp_para13 = <176>; //55
+	pmu_bat_temp_para14 = <150>; //60
+	pmu_bat_temp_para15 = <111>; //70
+	pmu_bat_temp_para16 = <83>; //80
+};
+
+&twi6 {
+	clock-frequency = <200000>;
+	pinctrl-0 = <&s_twi0_pins_a>;
+	pinctrl-1 = <&s_twi0_pins_b>;
+	// twi-supply = <&reg_aldo3>;
+	status = "okay";
+
+	pmu1: pmu@36 {
+		compatible = "x-powers,axp8191";
+		reg = <0x36>;
+		status = "okay";
+		regulator0: regulators@0 {
+			reg_dcdc1: dcdc1 {
+				regulator-name = "axp8191-dcdc1";
+			};
+			reg_dcdc2: dcdc2 {
+				regulator-name = "axp8191-dcdc2";
+			};
+			reg_dcdc3: dcdc3 {
+				regulator-name = "axp8191-dcdc3";
+			};
+			reg_dcdc4: dcdc4 {
+				regulator-name = "axp8191-dcdc4";
+			};
+			reg_dcdc5: dcdc5 {
+				regulator-name = "axp8191-dcdc5";
+			};
+			reg_dcdc6: dcdc6 {
+				regulator-name = "axp8191-dcdc6";
+			};
+			reg_dcdc7: dcdc7 {
+				regulator-name = "axp8191-dcdc7";
+			};
+			reg_dcdc8: dcdc8 {
+				regulator-name = "axp8191-dcdc8";
+			};
+			reg_dcdc9: dcdc9 {
+				regulator-name = "axp8191-dcdc9";
+			};
+			reg_rtcldo: rtcldo {
+				regulator-name = "axp8191-rtcldo";
+			};
+			reg_aldo1: aldo1 {
+				regulator-name = "axp8191-aldo1";
+			};
+			reg_aldo2: aldo2 {
+				regulator-name = "axp8191-aldo2";
+			};
+			reg_aldo3: aldo3 {
+				regulator-name = "axp8191-aldo3";
+			};
+			reg_aldo4: aldo4 {
+				regulator-name = "axp8191-aldo4";
+			};
+			reg_aldo5: aldo5 {
+				regulator-name = "axp8191-aldo5";
+			};
+			reg_aldo6: aldo6 {
+				regulator-name = "axp8191-aldo6";
+			};
+			reg_bldo1: bldo1 {
+				regulator-name = "axp8191-bldo1";
+			};
+			reg_bldo2: bldo2 {
+				regulator-name = "axp8191-bldo2";
+			};
+			reg_bldo3: bldo3 {
+				regulator-name = "axp8191-bldo3";
+			};
+			reg_bldo4: bldo4 {
+				regulator-name = "axp8191-bldo4";
+			};
+			reg_bldo5: bldo5 {
+				regulator-name = "axp8191-bldo5";
+			};
+			reg_cldo1: cldo1 {
+				regulator-name = "axp8191-cldo1";
+			};
+			reg_cldo2: cldo2 {
+				regulator-name = "axp8191-cldo2";
+			};
+			reg_cldo3: cldo3 {
+				regulator-name = "axp8191-cldo3";
+			};
+			reg_cldo4: cldo4 {
+				regulator-name = "axp8191-cldo4";
+			};
+			reg_cldo5: cldo5 {
+				regulator-name = "axp8191-cldo5";
+			};
+			reg_dldo1: dldo1 {
+				regulator-name = "axp8191-dldo1";
+			};
+			reg_dldo2: dldo2 {
+				regulator-name = "axp8191-dldo2";
+			};
+			reg_dldo3: dldo3 {
+				regulator-name = "axp8191-dldo3";
+			};
+			reg_dldo4: dldo4 {
+				regulator-name = "axp8191-dldo4";
+			};
+			reg_dldo5: dldo5 {
+				regulator-name = "axp8191-dldo5";
+			};
+			reg_dldo6: dldo6 {
+				regulator-name = "axp8191-dldo6";
+			};
+			reg_eldo1: eldo1 {
+				regulator-name = "axp8191-eldo1";
+			};
+			reg_eldo2: eldo2 {
+				regulator-name = "axp8191-eldo2";
+			};
+			reg_eldo3: eldo3 {
+				regulator-name = "axp8191-eldo3";
+			};
+			reg_eldo4: eldo4 {
+				regulator-name = "axp8191-eldo4";
+			};
+			reg_eldo5: eldo5 {
+				regulator-name = "axp8191-eldo5";
+			};
+			reg_eldo6: eldo6 {
+				regulator-name = "axp8191-eldo6";
+			};
+			reg_dc1sw1: dc1sw1 {
+				regulator-name = "axp8191-dc1sw1";
+				swin-supply = <&reg_dcdc1>;
+			};
+			reg_dc1sw2: dc1sw2 {
+				regulator-name = "axp8191-dc1sw2";
+				swin-supply = <&reg_dcdc1>;
+			};
+		};
+	};
+};
+
+&sdc0_pins_a {
+		allwinner,pins = "PF0", "PF1",
+				 "PF3", "PF4", "PF5";
+		allwinner,function = "sdc0";
+		allwinner,muxsel = <2>;
+		allwinner,drive = <0>;
+		allwinner,pull = <1>;
+};
+
+&sdc0_pins_b {
+		allwinner,pins = "PF2";
+		allwinner,function = "sdc0";
+		allwinner,muxsel = <2>;
+		allwinner,drive = <2>;
+		allwinner,pull = <1>;
+};
+
+&sdc0_pins_c {
+		allwinner,pins = "PF0", "PF1", "PF2",
+		  		 "PF3", "PF4", "PF5";
+		allwinner,function = "uart0_jtag";
+		allwinner,muxsel = <3>;
+		allwinner,drive = <0>;
+		allwinner,pull = <1>;
+};
+
+&sdc2_pins_a {
+		allwinner,pins = "PC6",
+				 "PC8", "PC9", "PC10", "PC11",
+				 "PC13", "PC14", "PC15", "PC16";
+		allwinner,function = "sdc3";
+		allwinner,muxsel = <4>;
+		allwinner,drive = <1>;
+		allwinner,pull = <1>;
+};
+
+&sdc2_pins_b {
+		allwinner,pins = "PC1", "PC5";
+		allwinner,function = "sdc3";
+		allwinner,muxsel = <4>;
+		allwinner,drive = <3>;
+		allwinner,pull = <1>;
+};
+
+&sdc2_pins_c {
+		allwinner,pins = "PC0";
+		allwinner,function = "sdc3";
+		allwinner,muxsel = <4>;
+		allwinner,drive = <3>;
+		allwinner,pull = <2>;
+};
+
+&pwm4_pin_active {
+		allwinner,pins = "PD22";
+		allwinner,function = "pwm0_4";
+		allwinner,muxsel = <0x2>;
+		allwinner,drive = <3>;
+		allwinner,pull = <2>;
+};
+
+&pwm4_pin_sleep {
+		allwinner,pins = "PD22";
+		allwinner,function = "io_disabled";
+		allwinner,muxsel = <0xf>;
+		allwinner,drive = <3>;
+		allwinner,pull = <2>;
+};
+
+&pwm16_pin_active {
+	allwinner,pins = "PI15";
+	allwinner,function = "pwm1_6";
+	allwinner,muxsel = <0x5>;
+	allwinner,drive = <3>;
+	allwinner,pull = <2>;
+};
+
+&pwm16_pin_sleep {
+	allwinner,pins = "PI15";
+	allwinner,function = "io_disabled";
+	allwinner,muxsel = <0xf>;
+	allwinner,drive = <3>;
+	allwinner,pull = <2>;
+};
+
+// &pwm18_pin_active {
+// 	allwinner,pins = "PJ26";
+// 	allwinner,function = "pwm1_8";
+// 	allwinner,muxsel = <0x3>;
+// 	allwinner,drive = <3>;
+// 	allwinner,pull = <2>;
+// };
+
+// &pwm18_pin_sleep {
+// 	allwinner,pins = "PJ26";
+// 	allwinner,function = "io_disabled";
+// 	allwinner,muxsel = <0xf>;
+// 	allwinner,drive = <3>;
+// 	allwinner,pull = <2>;
+// };
+
+&pwm19_pin_active {
+	allwinner,pins = "PE15";
+	allwinner,function = "pwm1_9";
+	allwinner,muxsel = <0x5>;
+	allwinner,drive = <3>;
+	allwinner,pull = <2>;
+};
+
+&pwm19_pin_sleep {
+	allwinner,pins = "PE15";
+	allwinner,function = "io_disabled";
+	allwinner,muxsel = <0xf>;
+	allwinner,drive = <3>;
+	allwinner,pull = <2>;
+};
+
+&spi0_pins_a {
+	allwinner,pins = "PC12", "PC2", "PC4";
+	allwinner,pname = "spi0_sclk", "spi0_mosi", "spi0_miso";
+	allwinner,function = "spi0";
+	allwinner,muxsel = <5>;
+	allwinner,drive = <1>;
+	allwinner,pull = <0>;
+};
+
+&spi0_pins_b {
+	allwinner,pins = "PC3", "PC15", "PC16";
+	allwinner,pname = "spi0_cs0", "spi0_wp", "spi0_hold";
+	allwinner,function = "spi0";
+	allwinner,muxsel = <5>;
+	allwinner,drive = <1>;
+	allwinner,pull = <1>;
+};
+
+&spi0_pins_c {
+	allwinner,pins = "PC2", "PC3", "PC4", "PC12",
+					"PC15", "PC16";
+	allwinner,function = "gpio_in";
+	allwinner,muxsel = <0>;
+	allwinner,drive = <1>;
+	allwinner,pull = <0>;
+};
+
+&spi0 {
+	clock-frequency = <5000000>;
+	pinctrl-0 = <&spi0_pins_a &spi0_pins_b>;
+	pinctrl-1 = <&spi0_pins_c>;
+	pinctrl-names = "default", "sleep";
+	/*spi-supply = <&reg_cldo5>;*/
+	spi_slave_mode = <0>;
+	spi0_cs_number = <1>;
+	spi0_cs_bitmap = <1>;
+	status = "okay";
+
+	spi_board0 {
+		device_type = "spi_board0";
+		compatible = "spi-nor";
+		spi-max-frequency = <5000000>;
+		m25p,fast-read = <1>;
+		reg = <0x0>;
+		spi-rx-bus-width = <0x1>;
+		spi-tx-bus-width = <0x1>;
+		status = "okay";
+	};
+};
+
+&mmc0 {
+	vmmc-supply = <&reg_dc1sw2>;
+	cd-gpios = <&pio 5 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>; //PF6
+	bus-width = <4>;
+	status = "okay";
+};
+
+/*
+ *recovery_adc_used :  Module enable pin,    1: Enabled, 0: Disabled
+ *press_mode_enable :  Long/short press mode enable, 1: Enabled, 0: Disabled
+ *                     a) If this mode is enabled, key_work_mode is disabled, and short_press_mode and long_press_mode take effect;
+ *                     the recovery button can trigger two different modes via long press and short press;
+ *                     b) If this mode is disabled, key_work_mode takes effect, and the recovery button can only trigger one mode.
+ *key_work_mode     :  Mode selection
+ *                     0: Flash ROM,
+ *                     1: One-click recovery (U-Boot stage),
+ *                     2: Android recovery,
+ *                     3: Android factory reset.
+ *                     If not set, the default mode is Android Recovery.
+ *short_press_mode  :  Mode triggered by a short press; options are the same as above.
+ *long_press_mode   :  Mode triggered by a long press; options are the same as above.
+ *key_press_time    :  Defines the duration of a long press; unit: milliseconds.
+ *recovery_key      :  Key configuration.
+ */
+&adc_boot_recovery {
+	recovery_adc_used = <1>;
+	recovery_adc_channel = <0>; /* vol+ key */
+	press_mode_enable = <1>;
+	short_press_mode = <0x0>;
+	long_press_mode = <0x2>;
+	key_press_time = <2000>;
+	key_min = <9>;
+	key_max = <11>;
+};
+
+&gpadc_boot_recovery {
+	recovery_adc_used = <1>;
+	recovery_adc_channel = <9>; /* recovery key */
+	press_mode_enable = <1>;
+	short_press_mode = <0x0>;
+	long_press_mode = <0x3>;
+	key_press_time = <5000>;
+	key_min = <455>;
+	key_max = <500>;
+};
+
+&serdes {
+	status = "okay";
+	combophy0: combo-phy0@6c01000 {
+		lane_invert = <0 0 0 0>;
+		lane_remap = <2 3 0 1>;
+	};
+};
+
+&sid {
+	sid-supply = <&reg_dldo1>;
+	voltage = <1800>;
+	power_supply = "dldo6";
+};
+
+&pwm4{
+	pinctrl-names = "active","sleep";
+	pinctrl-0 = <&pwm4_pin_active>;
+	pinctrl-1 = <&pwm4_pin_sleep>;
+	status = "okay";
+};
+
+&pwm16 {
+	pinctrl-names = "active","sleep";
+	pinctrl-0 = <&pwm16_pin_active>;
+	pinctrl-1 = <&pwm16_pin_sleep>;
+	status = "disabled";
+};
+
+// &pwm18 {
+// 	pinctrl-names = "active","sleep";
+// 	pinctrl-0 = <&pwm18_pin_active>;
+// 	pinctrl-1 = <&pwm18_pin_sleep>;
+// 	status = "okay";
+// };
+
+&pwm19 {
+	pinctrl-names = "active","sleep";
+	pinctrl-0 = <&pwm19_pin_active>;
+	pinctrl-1 = <&pwm19_pin_sleep>;
+	status = "okay";
+};
+
+&pcie_rc {
+	status = "okay";
+	pcie1v8-supply = <&reg_bldo1>;
+	pcie3v3-supply = <&reg_dcdc1>;
+};
