+	recovery_adc_channel = <0>; /* vol+ key */
+	press_mode_enable = <1>;
+	short_press_mode = <0x0>;
+	long_press_mode = <0x2>;
+	key_press_time = <2000>;
+	key_min = <9>;
+	key_max = <11>;
