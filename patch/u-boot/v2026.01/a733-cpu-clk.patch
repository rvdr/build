diff --git a/arch/arm/include/asm/arch-sunxi/clock_sun50i_h6.h b/arch/arm/include/asm/arch-sunxi/clock_sun50i_h6.h
index 111111111111..222222222222 100644
--- a/arch/arm/include/asm/arch-sunxi/clock_sun50i_h6.h
+++ b/arch/arm/include/asm/arch-sunxi/clock_sun50i_h6.h
@@ -113,10 +113,17 @@
 
 #define CCM_PLL6_DEFAULT		0xe8216310	    /* 1200 MHz */
 #define CCM_PSI_AHB1_AHB2_DEFAULT	0x03000002	    /* 200 MHz */
 #define CCM_APB1_DEFAULT		0x03000005	    /* APB0 really */
 #define CCM_APB2_DEFAULT		0x03000005	    /* APB1 really */
+
+#elif CONFIG_MACH_SUN60I_A733				/* A733 */
+
+#define CCM_PLL6_DEFAULT          0x80001800
+#define CCM_PSI_AHB1_AHB2_DEFAULT 0x03000002
+#define CCM_APB1_DEFAULT          0x03000005
+#define CCM_APB2_DEFAULT          0x03000005 /* or 0x00000000 */
 #endif
 
 /* apb2 bit field */
 #define APB2_CLK_SRC_OSC24M		(0x0 << 24)
 #define APB2_CLK_SRC_OSC32K		(0x1 << 24)
diff --git a/arch/arm/mach-sunxi/clock_sun50i_h6.c b/arch/arm/mach-sunxi/clock_sun50i_h6.c
index 111111111111..222222222222 100644
--- a/arch/arm/mach-sunxi/clock_sun50i_h6.c
+++ b/arch/arm/mach-sunxi/clock_sun50i_h6.c
@@ -46,11 +46,11 @@ void clock_init_safe(void)
 
 	writel(CCM_PLL6_DEFAULT, ccm + CCU_H6_PLL6_CFG);
 	while (!(readl(ccm + CCU_H6_PLL6_CFG) & CCM_PLL_LOCK))
 		;
 
-	if (!IS_ENABLED(CONFIG_MACH_SUN55I_A523))
+	if (!IS_ENABLED(CONFIG_MACH_SUN55I_A523) || IS_ENABLED(CONFIG_MACH_SUN60I_A733))
 		clrsetbits_le32(ccm + CCU_H6_CPU_AXI_CFG,
 				CCM_CPU_AXI_APB_MASK | CCM_CPU_AXI_AXI_MASK,
 				CCM_CPU_AXI_DEFAULT_FACTORS);
 
 	writel(CCM_PSI_AHB1_AHB2_DEFAULT, ccm + CCU_H6_PSI_AHB1_AHB2_CFG);
@@ -123,11 +123,11 @@ static void clock_set_pll(u32 *reg, unsigned int n)
 	if (IS_ENABLED(CONFIG_SUNXI_GEN_NCAT2))
 		val |= CCM_PLL_LDO_EN;
 	writel(val, reg);			/* enable PLL */
 
 	val |= CCM_PLL_LOCK_EN;
-	if (IS_ENABLED(CONFIG_MACH_SUN55I_A523))
+	if (IS_ENABLED(CONFIG_MACH_SUN55I_A523) || IS_ENABLED(CONFIG_MACH_SUN60I_A733))
 		val |= CCM_PLL1_UPDATE;
 	writel(val, reg);			/* start locking process */
 
 	while (!(readl(reg) & CCM_PLL_LOCK)) {	/* wait for lock bit */
 	}
